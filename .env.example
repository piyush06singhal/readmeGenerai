# README.3D — server-side configuration
#
# Copy this file to `.env` and fill in your own values. This file is never
# sent to the browser — the API key is read ONLY by the server (server/ai.ts)
# and used to call Groq on the user's behalf.

# Your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: override the Groq model used for README generation.
# Defaults to llama-3.3-70b-versatile if unset.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: GitHub token to increase GitHub REST API rate limits from 60 to 5,000 req/hr.
# GITHUB_TOKEN=

# Optional: API base URL override (advanced). Unset → https://api.groq.com/openai/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Set this only when the app runs behind a trusted reverse proxy that sets
# x-forwarded-for. Leave unset for direct deployments.
# TRUST_PROXY=true
